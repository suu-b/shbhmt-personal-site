---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Thumbnail from "../components/Thumbnail.astro";
import { Image } from "astro:assets";
import bg from "../../public/assets/cs_bg.png";

const posts = await getCollection("articles");
const activePosts = posts.filter((p) => !p.data.draft);
const csPosts = activePosts.filter((post) =>
  post.data.tags?.some((tag: string) => {
    const lowerTag = tag.toLowerCase();
    return lowerTag === "computer-science";
  })
);

const sortedPosts = csPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const giants = await getCollection("giants");
const csGiants = (giants.find(g => g.id === 'computer-science')?.data || []) as Array<{
  name: string;
  description: string;
  link?: string;
  content: string;
}>;

const projects = await getCollection("projects");
const activeProjects = projects.filter((p) => !p.data.draft);

function formatDate(date: Date) {
  const day = date.getDate();
  const month = date.toLocaleString("default", { month: "long" });
  const year = date.getFullYear();

  const suffix =
    day % 10 === 1 && day !== 11
      ? "st"
      : day % 10 === 2 && day !== 12
        ? "nd"
        : day % 10 === 3 && day !== 13
          ? "rd"
          : "th";

  return `${month} ${day}${suffix}, ${year}`;
}
---

<BaseLayout title="Computer Science | Shubham Thakur">
  <section class="w-full my-12 font-serif">
    <!-- Back Link -->
    <a href="/" class="link-back mb-8">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-4 h-4"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back
    </a>

    <Thumbnail
        src={bg}
        alt="Crayons"
        subtitle="I chose to represent Computer Science with crayons - because I really think that it helped me realize that I can create. Personally, it is just like a set of crayons, it is upon the creator to make an intent, pick the correct crayons, and paint a beautiful painting! I want to have a more artistic approach to this field."
      />
    <h1 class="text-3xl text-slate-200 font-bold mb-3">Computer Science</h1>
    <p class="text-lg sm:text-xl text-slate-300 mb-6">As of now, most of my day is actually Computer Science, specifically, CS Engineering. Throughout the day, I am either doing my work or looking for gaps in my knowledge (which are many) to fill by learning. As I plan to have a long term engagement with this field, I keep on exploring what I can do. This page is a collection of that.</p>

    <!-- ROLL OUT ONCE GIANTS LIST IS FINALIZED -->
    <!-- {csGiants.length > 0 && (
      <div>
        <p class="text-lg sm:text-xl text-slate-300"><i>...by standing on the shoulders of Giants</i> is a phrase attributed to Newton, and I firmly believe in it. These are some of the <i>Giants</i> of Computer Science I look up to:</p>
        <div class="relative">
          <p class="text-lg sm:text-xl text-slate-200 font-serif">
            {
              csGiants.map((giant, index) => (
                <>
                  <span
                    class="link-dotted text-slate-200 hover:text-slate-100 giant-link cursor-pointer"
                    data-giant-name={giant.name}
                    data-giant-description={giant.description || ''}
                    data-giant-content={giant.content || ''}
                    data-giant-link={giant.link || ''}
                  >
                    {giant.name}
                  </span>
                  {index < csGiants.length - 1 && <span>, </span>}
                </>
              ))
            }
          </p>
        </div>
      </div>
    )} -->

    <h3 class="text-2xl text-slate-300 mt-6 mb-5 text-center font-semibold">Latest</h3>

    <div
      class="mb-6 flex flex-col sm:flex-row gap-4 items-center justify-between"
    >
      <!-- Search Box -->
      <div class="flex items-center gap-2 flex-1 w-full">
        <div class="relative flex-1 w-full">
          <input
            type="text"
            id="cs-search-input"
            placeholder="Search CS articles..."
            class="search-input !pl-4"
          />
        </div>
        <button
          id="cs-search-btn"
          class="btn-secondary w-12 h-12 flex-shrink-0 flex items-center justify-center rounded-lg"
          title="Search"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
            ></path>
          </svg>
        </button>
      </div>

      <!-- See All Link -->
      <a href="/articles?tags=computer-science" class="btn-primary"> See All </a>
    </div>

    <!-- Articles List -->
    <div id="articles-list" class="flex flex-col">
      {
        sortedPosts.map((post, index) => {
          return (
            <div
              class={`post-list-item relative group ${
                index < sortedPosts.length - 1
                  ? "border-b border-[#2D3033]"
                  : ""
              }`}
            >
              <h3 class="list-item-title">
                <a
                  href={`/articles/${post.id}`}
                  class="after:absolute after:inset-0 after:z-0"
                >
                  {post.data.title}
                </a>
              </h3>
              <p class="list-item-desc">{post.data.description}</p>
              <div class="list-item-meta">
                <span class="text-sm text-slate-500">
                  {formatDate(post.data.date)}
                </span>
                {post.data.tags &&
                  post.data.tags.map((tag) => (
                    <a
                      href={`/articles?tags=${tag}`}
                      class="badge-tag relative z-10 hover:text-slate-300 hover:border-slate-500 transition-colors"
                    >
                      {tag}
                    </a>
                  ))}
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- Projects Section -->
    {activeProjects.length > 0 && (
      <div class="mt-16">
        <h3 class="text-2xl text-slate-300 text-center font-semibold">Projects</h3>
        <div class="flex flex-col items-center">
          {
            activeProjects.map((project, index) => {
              return (
              <div
                class={`post-list-item relative group w-full sm:w-[70%] ${
                  index < activeProjects.length - 1
                    ? "border-b border-[#2D3033]"
                    : ""
                }`}
              >
                {project.data.thumbnail && (
                  <div class="w-full mb-4">
                    <a href={`/projects/${project.id}`}>
                      <img
                        src={project.data.thumbnail}
                        alt={project.data.title}
                        class="w-full h-auto rounded-lg"
                        loading="lazy"
                      />
                    </a>
                  </div>
                )}
                <h3 class="list-item-title flex items-center gap-2">
                  <a
                    href={`/projects/${project.id}`}
                    class="after:absolute after:inset-0 after:z-0"
                  >
                    {project.data.title}
                  </a>
                  {project.data.github && (
                    <a
                      href={project.data.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-slate-500 hover:text-slate-300 transition-colors relative z-10"
                      title="View external link"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                        class="w-5 h-5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        />
                      </svg>
                    </a>
                  )}
                </h3>
                {project.data.techStack && project.data.techStack.length > 0 && (
                  <div class="list-item-meta">
                    {project.data.techStack.map((tech) => (
                      <span class="badge-tag hover:text-slate-300 hover:border-slate-500 transition-colors">
                        {tech}
                      </span>
                    ))}
                  </div>
                )}
                <p class="list-item-desc mt-6">{project.data.description}</p>
              </div>
            );
            })
          }
        </div>
      </div>
    )}

    <!-- Giant Popup -->
    <div id="giant-popup" class="fixed bg-[#0a0a0a] rounded-lg shadow-xl p-5 max-w-md min-w-[280px] sm:min-w-[300px] min-h-[150px] z-50 text-slate-200 left-4 right-4 sm:left-auto sm:right-auto">
      <p id="popup-description" class="text-slate-400 text-lg mb-4"></p>
      <p id="popup-content" class="leading-relaxed text-justify text-lg text-slate-300 mb-5"></p>
      <p class="leading-relaxed text-justify text-lg text-slate-300">
        Know more{" "}
        <a
          id="popup-link"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="link-dotted text-slate-300 hover:text-slate-200 transition-colors"
        >
          here
        </a>
      </p>
    </div>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const popup = document.getElementById('giant-popup');
        const popupDescription = document.getElementById('popup-description');
        const popupContent = document.getElementById('popup-content');
        const popupLink = document.getElementById('popup-link');
        const giantLinks = document.querySelectorAll('.giant-link');

        let hideTimeout = null;

        function showPopup(element) {
          const description = element.getAttribute('data-giant-description');
          const content = element.getAttribute('data-giant-content');
          const link = element.getAttribute('data-giant-link');

          if (popupDescription) popupDescription.textContent = `“${description}”`;
          if (popupContent) popupContent.textContent = content || '';

          if (popupLink) {
            if (link) {
              popupLink.href = link;
              popupLink.classList.remove('hidden');
            } else {
              popupLink.classList.add('hidden');
            }
          }

          const rect = element.getBoundingClientRect();
          if (popup) {
            const isMobile = window.innerWidth < 640;
            if (isMobile) {
              popup.style.left = 'auto';
              popup.style.right = 'auto';
              popup.style.top = `${rect.bottom + 8}px`;
            } else {
              popup.style.left = `${rect.left}px`;
              popup.style.top = `${rect.bottom + 8}px`;
            }
            popup.classList.remove('hidden');
          }

          if (hideTimeout) {
            clearTimeout(hideTimeout);
            hideTimeout = null;
          }
        }

        function hidePopup() {
          hideTimeout = window.setTimeout(() => {
            if (popup) popup.classList.add('hidden');
          }, 200);
        }

        giantLinks.forEach((link) => {
          link.addEventListener('mouseenter', () => showPopup(link));
          link.addEventListener('mouseleave', hidePopup);
        });

        if (popup) {
          popup.addEventListener('mouseenter', () => {
            if (hideTimeout) {
              clearTimeout(hideTimeout);
              hideTimeout = null;
            }
          });
          popup.addEventListener('mouseleave', hidePopup);
        }
      });
    </script>

    <script is:inline>
      const searchInput = document.getElementById("cs-search-input");
      const searchBtn = document.getElementById("cs-search-btn");

      function triggerSearch() {
        if (searchInput) {
          const query = searchInput.value.trim();
          if (query) {
            window.location.href = `/articles?q=${encodeURIComponent(query)}&tags=computer-science`;
          } else {
            window.location.href = "/articles?tags=computer-science";
          }
        }
      }

      searchInput?.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          triggerSearch();
        }
      });

      searchBtn?.addEventListener("click", () => {
        triggerSearch();
      });
    </script>
  </section>
</BaseLayout>
