---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Giants | Preface">
  <section class="w-full my-12 font-serif">
    <!-- Back Link -->
    <a href="/" class="link-back mb-8">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-4 h-4"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back
    </a>

    <h1 class="text-3xl text-slate-200 font-bold mb-6">Poems</h1>
    <p class="text-slate-400 italic mb-8">
      that I either found interesting or sentimental.
    </p>

    <ul class="list-disc pl-5 space-y-2 font-serif text-xl">
      <li>
        <a
          href="https://www.poetryfoundation.org/poetrymagazine/poems/58579/camera-obscura"
          class="link-dotted text-slate-200 hover:text-slate-100"
          target="_blank"
        >
          Simon Armitage - 'Camera Obscura'
        </a>
      </li>
      <li>
        <a
          href="https://genius.com/8672835"
          class="link-dotted text-slate-200 hover:text-slate-100"
          target="_blank"
        >
          Simon Armitage - 'Remains'
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>
