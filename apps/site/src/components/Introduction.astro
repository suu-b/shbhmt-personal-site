---

---

<section
    class="min-h-screen flex flex-col items-center justify-center text-xl sm:text-2xl md:text-3xl text-[#f3f3f3] text-justify w-full max-w-full md:max-w-[50vw] px-4 mx-auto"
>
    <a
        href="https://en.wikipedia.org/wiki/Vitruvian_Man"
        target="_blank"
        rel="noopener noreferrer"
        class="block mx-auto mb-5 w-fit h-28"
    >
        <img
            class="logo-link"
            src="/assets/renaissance_man.png"
            alt="The Vitruvian Man, alternatively called the Renaissance Man"
        />
    </a>

    <div class="mb-2 text-center">
        <h1 class="text-xl text-slate-200">Hey, I'm Shubham!</h1>
    </div>

    <div class="mb-2 text-center">
        <p class="text-xl text-slate-300">
            As of Spring 2025, I am a CS student.
        </p>
    </div>

    <div class="mb-2 text-center">
        <p class="text-xl mx-auto text-center font-light text-slate-300">
            I aspire to be a <a
                href="https://en.wikipedia.org/wiki/Polymath"
                class="underline decoration-dotted text-slate-300">polymath</a
            >. This site is a preface to me.
        </p>
    </div>

    <div class="flex flex-col items-center mt-8 animate-bounce">
        <p class="text-sm text-gray-400">Scroll down</p>
        <svg
            class="mt-2 w-5 h-5 text-gray-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
    </div>
</section>
