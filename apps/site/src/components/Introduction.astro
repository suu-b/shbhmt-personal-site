---
import { Image } from "astro:assets";
import renaissanceManImg from "../../public/assets/renaissance_man.png";
---

<section
    class="min-h-screen flex flex-col items-center justify-center text-xl sm:text-2xl md:text-3xl text-[#f3f3f3] text-justify w-full max-w-full md:max-w-[50vw] px-4 mx-auto"
>
    <!-- Vitruvian Man Image -->
    <a
        href="https://en.wikipedia.org/wiki/Vitruvian_Man"
        target="_blank"
        rel="noopener noreferrer"
        class="block mx-auto mb-5 w-fit h-28 animate-delayed-item delay-4"
    >
        <Image
            src={renaissanceManImg}
            alt="The Vitruvian Man, alternatively called the Renaissance Man"
            class="logo-link"
            loading="eager"
            fetchpriority="high"
        />
    </a>

    <!-- Point 1 -->
    <div class="mb-2 text-center animate-item delay-1">
        <h1 class="text-xl text-slate-200">Hey, I'm Shubham!</h1>
    </div>

    <!-- Point 2 -->
    <div class="mb-2 text-center animate-item delay-2">
        <p class="text-xl text-slate-300">
            As of Spring 2025, I am a CS student.
        </p>
    </div>

    <!-- Point 3 -->
    <div class="mb-2 text-center animate-item delay-3">
        <p class="text-xl mx-auto text-center font-light text-slate-300">
            I aspire to be a <a
                href="https://en.wikipedia.org/wiki/Polymath"
                class="link-dotted">polymath</a
            >. This site is a preface to me.
        </p>
    </div>

    <!-- Scroll Down Indicator (Delayed fade-in outer wrapper, infinite bounce inner) -->
    <div class="animate-delayed-item delay-4 mt-8">
        <div class="flex flex-col items-center animate-bounce">
            <p class="text-sm text-gray-400">Scroll down</p>
            <svg
                class="mt-2 w-5 h-5 text-gray-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
        </div>
    </div>
</section>

<style>
    /* Fade-in and slide-up keyframes for text points */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Gentle, slower fade-in keyframes for logo and scroll arrow */
    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    .animate-item {
        opacity: 0;
        animation: fadeInUp 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .animate-delayed-item {
        opacity: 0;
        animation: fadeIn 1.2s ease-out forwards;
    }

    /* Sequenced animation delays */
    .delay-1 {
        animation-delay: 0.2s;
    }
    .delay-2 {
        animation-delay: 1.3s;
    }
    .delay-3 {
        animation-delay: 2.3s;
    }
    .delay-4 {
        animation-delay: 3.2s; /* Starts rendering after the 3 text points are fully loaded */
    }
</style>
